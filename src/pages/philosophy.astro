---
import Default from '../layouts/Default.astro';
import data from '../../blogs.json';

function parseDate(string) {
  const [day, month, year] = string.split('/').map((part) => parseInt(part, 10));
  return new Date(year, month - 1, day);
}

function yearOf(string) {
  return string.split('/')[2];
}

const posts = [...(data.philosophy || [])].sort(
  (a, b) => parseDate(b.date) - parseDate(a.date)
);
---

<Default title="Philosophy | h4ppyr0gu3" description="Philosophy notes and essays">
  <div class="listing">
    <form class="listing-search" data-listing-search>
      <label for="philosophySearch" class="sr-only">Search</label>
      <div class="listing-search-field">
        <svg class="listing-search-icon" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="search"
          id="philosophySearch"
          name="search"
          data-listing-input
          class="listing-search-input"
          placeholder="Search philosophy..."
          autocomplete="off"
        />
        <button type="submit" class="listing-search-btn">Search</button>
      </div>
    </form>

    <ul class="listing-list" data-listing-list>
      {posts.map((item, index) => {
        const year = yearOf(item.date);
        const prevYear = index > 0 ? yearOf(posts[index - 1].date) : null;
        return (
          <>
            {year !== prevYear && (
              <li class="listing-group" data-listing-group={year}>{year}</li>
            )}
            <li
              class="listing-item"
              data-listing-item
              data-search={`${item.title} ${item.excerpt ?? ''} ${(item.tags || []).join(' ')}`}
            >
              <a href={item.href} title={item.excerpt}>{item.title}</a>
            </li>
          </>
        );
      })}
      <li class="listing-empty" data-listing-empty hidden>No matching essays</li>
    </ul>
  </div>

  <script>
    import '../scripts/listing-search.js';
  </script>
</Default>
