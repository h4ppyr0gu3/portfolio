---
import Default from '../layouts/Default.astro';
import data from '../../blogs.json';

const til = [...data.til].sort((a, b) => a.topics.localeCompare(b.topics));
---

<Default title="TIL | h4ppyr0gu3" description="Things I learned">
  <div class="mx-auto max-w-xl px-6 pb-5 pt-6">
    <form class="mb-4" data-listing-search>
      <label for="tilSearch" class="sr-only">Search</label>
      <div class="relative mx-auto max-w-sm">
        <svg
          class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-ink-faint"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="search"
          id="tilSearch"
          name="search"
          data-listing-input
          class="w-full border-0 border-b border-line bg-transparent py-3 pl-10 pr-24 text-sm text-ink placeholder:text-ink-faint focus:border-tender-blue focus:outline-none dark:border-line-dark dark:text-ink-invert"
          placeholder="Search for a Lesson..."
          autocomplete="off"
        />
        <button
          type="submit"
          class="absolute bottom-2 right-1 rounded-md bg-tender-blue px-3 py-1.5 text-sm font-bold text-ink hover:bg-[#b3deef]"
        >
          Search
        </button>
      </div>
    </form>

    <ul class="m-0 list-none p-0 text-center" data-listing-list>
      {til.map((item, index) => {
        const topic = item.topics;
        const prevTopic = index > 0 ? til[index - 1].topics : null;
        return (
          <>
            {topic !== prevTopic && (
              <li
                class="mb-0 mt-3 list-none text-xl font-bold text-tender-yellow first:mt-0"
                data-listing-group={topic}
              >
                {topic}
              </li>
            )}
            <li
              class="list-none leading-tight"
              data-listing-item
              data-search={`${item.title} ${item.excerpt ?? ''} ${item.topics ?? ''} ${(item.tags || []).join(' ')}`}
            >
              <a
                href={item.href}
                title={item.excerpt}
                class="inline-block py-0 text-2xl font-bold tracking-tight text-ink no-underline hover:text-tender-green hover:underline hover:decoration-tender-green hover:underline-offset-2 dark:text-ink-invert"
              >
                {item.title}
              </a>
            </li>
          </>
        );
      })}
      <li class="mt-3 list-none font-semibold text-ink-faint" data-listing-empty hidden>
        Nothing learnt here
      </li>
    </ul>
  </div>

  <script>
    import '../scripts/listing-search.js';
  </script>
</Default>
