---
import Default from '../layouts/Default.astro';
import CvApp from '../components/cv/CvApp.jsx';
import CV from '../../cv.json';
---

<Default title="CV Generator | h4ppyr0gu3" description="Create and share a CV in the same layout as this site — frontend only, saved in your browser.">
  <div class="cv-builder">
    <h1>CV Generator</h1>
    <p class="cv-builder-lede">
      Build a CV in this site’s layout. Start from the example, edit freely, save locally, then share a link or export PDF/JSON.
    </p>
    <CvApp client:only="react" siteCv={CV} />
  </div>
</Default>
